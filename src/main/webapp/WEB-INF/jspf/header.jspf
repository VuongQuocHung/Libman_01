<%@ page import="libman.model.Member5" %>
<%@ include file="/WEB-INF/jspf/helpers.jspf" %>
<%
    // Trang nhúng phải khai báo trước: String pageTitle
    Member5 hdrMember = (Member5) session.getAttribute("member");
    String hdrRole = (String) session.getAttribute("role");
    String ctx = request.getContextPath();
    String hdrHome = ctx + "/index.jsp";

    String hdrRoleLabel = "Độc giả";
    if ("LIBRARIAN".equals(hdrRole)) {
        hdrRoleLabel = "Nhân viên thư viện";
    }

    // Chữ cái đầu của tên gọi (từ cuối trong họ tên) để vẽ avatar
    String hdrInitial = "";
    if (hdrMember != null && hdrMember.getFullName() != null) {
        String[] hdrWords = hdrMember.getFullName().trim().split("\\s+");
        hdrInitial = hdrWords[hdrWords.length - 1].substring(0, 1).toUpperCase();
    }

    // Thông báo một lần do trang trước để lại trong session (sống qua một lần chuyển trang).
    // Ba loại: errorMessage, successMessage, infoMessage
    String hdrMessage = null;
    String hdrMessageType = null;
    String[] hdrTypes = {"error", "success", "info"};
    for (String type : hdrTypes) {
        String text = (String) session.getAttribute(type + "Message");
        if (text != null) {
            hdrMessage = text;
            hdrMessageType = type;
            session.removeAttribute(type + "Message");
        }
    }

    String hdrMessageRole = "status";
    if ("error".equals(hdrMessageType)) {
        hdrMessageRole = "alert";
    }
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= esc(pageTitle) %> · LibMan</title>
  <link rel="icon" href="<%= ctx %>/assets/images/ptit-logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap&subset=vietnamese"
        rel="stylesheet">
  <link rel="stylesheet" href="<%= ctx %>/assets/css/libman.css">
</head>
<body>
<header class="topbar no-print">
  <div class="topbar-inner">
    <a class="brand" href="<%= hdrHome %>">
      <img src="<%= ctx %>/assets/images/ptit-logo.png" alt="Logo PTIT">
      <span class="brand-text">
        <span class="brand-name">LibMan</span>
        <span class="brand-sub">Thư viện Học viện Công nghệ Bưu chính Viễn thông</span>
      </span>
    </a>
    <% if (hdrMember != null) { %>
    <div class="userchip">
      <span class="avatar" aria-hidden="true"><%= esc(hdrInitial) %></span>
      <span class="who">
        <%= esc(hdrMember.getFullName()) %>
        <small><%= hdrRoleLabel %></small>
      </span>
      <a class="logout" href="<%= ctx %>/doLogout.jsp"
         onclick="return confirm('Bạn muốn đăng xuất khỏi LibMan?');">Đăng xuất</a>
    </div>
    <% } %>
  </div>
</header>
<main class="wrap">
<% if (hdrMessage != null) { %>
  <div class="alert alert-<%= hdrMessageType %>" role="<%= hdrMessageRole %>">
    <%= esc(hdrMessage) %>
  </div>
<% } %>
